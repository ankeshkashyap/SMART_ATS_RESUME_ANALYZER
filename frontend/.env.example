# Copy this file to .env and fill in real values. NEVER commit .env.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# REQUIRED — backend API base URL (production)
# Set this to your deployed Render URL, e.g.:
#   VITE_API_BASE_URL=https://smart-resume-ats-analyzer.onrender.com
VITE_API_BASE_URL=

# OPTIONAL — local development override
# .env.development takes precedence over this file during `npm run dev`
# VITE_API_BASE_URL=http://localhost:8000